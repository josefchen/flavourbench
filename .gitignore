.DS_Store
.env
.env.*
!.env.example
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
__pycache__/
*.py[cod]
*.sqlite3
*.db
*.log
*.partial
*.tmp

# Local benchmark evidence and credentials are never public artifacts.
flavourbench/artifacts/
flavourbench/data/*.sqlite3
data/private/
secrets/

# Paper build intermediates. Canonical release files are explicitly retained.
paper/build/*
!paper/build/ARTIFACTS.sha256
!paper/build/flavourbench.pdf
!paper/build/flavourbench-arxiv-source.tar.gz
paper/neurips2026/build/*
!paper/neurips2026/build/flavourbench-neurips2026-*.pdf

# Hugging Face export scratch space.
hf/.cache/
hf/**/.gradio/

# Private deployment-recovery forensics are not part of the public benchmark package.
tests/legacy_0001_upgrade_bridge_test.py
tests/rollback_api_*.py
